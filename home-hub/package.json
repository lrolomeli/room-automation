{
  "name": "home-hub",
  "version": "1.0.0",
  "private": true,
  "description": "Hub unificado para Zigbee2MQTT y la habitación (ESP32)",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w @home-hub/api",
    "dev:web": "npm run dev -w @home-hub/web",
    "build": "npm run build -w @home-hub/web",
    "start": "npm run start -w @home-hub/api",
    "typecheck": "npm run typecheck -w @home-hub/web",
    "check": "npm run check -w @home-hub/api && npm run typecheck -w @home-hub/web"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
