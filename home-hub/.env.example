# Copia este archivo a .env y ajusta los valores.
# No subas .env a git.

PORT=3000

# MQTT / Zigbee2MQTT
MQTT_URL=mqtt://mqtt:1883
Z2M_BASE_TOPIC=zigbee2mqtt
MQTT_USERNAME=
MQTT_PASSWORD=

# ESP32 (sensor de temperatura/humedad + emisor IR)
# Ejemplo: cambia por la IP real de tu ESP32.
ESP_HOST=192.168.1.50
ESP_PORT=80

# Zona horaria de las rutinas del clima y del temporizador.
# No la cambies sin revisar las reglas 22:30-04:30.
CLIMATE_TZ=America/Mexico_City
# Zona horaria de logs del contenedor.
TZ=America/Mexico_City

# Autenticación del dashboard (contraseña compartida)
DASHBOARD_PASSWORD=change-me-please
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_TTL_DAYS=30

# Detrás de HTTPS (ra.luisrlp.com) pon true.
COOKIE_SECURE=false
# Detrás de un reverse proxy pon 1.
TRUST_PROXY=0
# Origen permitido si el proxy reescribe el Host.
ALLOWED_ORIGIN=

# Solo para desarrollo local. Nunca en producción.
AUTH_DISABLED=0

# shadow: solo registra las reglas; live: envía comandos.
AUTOMATION_MODE=shadow

LOG_LEVEL=info
