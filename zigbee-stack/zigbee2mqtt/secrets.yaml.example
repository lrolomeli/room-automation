# Copia este archivo a secrets.yaml y define tu network key.
# No subas secrets.yaml a git.
#
# Si es una red Zigbee existente, usa los 16 bytes de tu key actual.
# Si es una red nueva, genera una con:
#   node -e "console.log(Array.from(require('crypto').randomBytes(16)))"
#
# network_key:
#   - 0
#   - 0
#   - 0
